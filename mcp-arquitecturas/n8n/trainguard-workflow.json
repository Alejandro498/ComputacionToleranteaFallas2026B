      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Webhook TrainGuard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "trainguard-demo"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst mode = body.mode || 'demo';\nconst kind = body.kind || 'nan_loss';\nconst bridge = body.bridge_base_url || 'https://REPLACE_WITH_NGROK.ngrok-free.app';\n\nreturn [{\n  json: {\n    mode,\n    kind,\n    bridge_base_url: bridge.replace(/\\/$/, ''),\n    requested_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.mode }}",
                    "rightValue": "demo",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "cond-demo"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "demo"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.mode }}",
                    "rightValue": "analyze",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "cond-analyze"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "analyze"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.mode }}",
                    "rightValue": "inject",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "cond-inject"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "inject"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
