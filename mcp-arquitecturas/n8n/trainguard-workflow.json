        "options": {
          "timeout": 30000
        }
      },
      "id": "b8c9d0e1-f2a3-4567-1234-678901234567",
      "name": "Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 0]
    },
    {
      "parameters": {
        "jsCode": "const analyzed = $('Analyze and Apply').item.json;\nconst status = $json;\nconst decision = analyzed.decision || analyzed;\nconst mcpFromAnalyze = analyzed.mcp_tools_called || analyzed._meta?.mcp_tools_called || [];\nconst mcpFromStatus = status.mcp_tools_called || status._meta?.mcp_tools_called || [];\nconst tools = [...mcpFromAnalyze, ...mcpFromStatus].map(t => t.tool);\nconst uniqueTools = [...new Set(tools)];\nconst story = analyzed.mcp_story || `n8n → bridge → ${uniqueTools.map(t => 'MCP:' + t).join(' → ')}`;\n\nconst banner = [\n  '╔══════════════════════════════════════════╗',\n  '║     TRAINGUARD · LLAMADA VÍA MCP          ║',\n  '╠══════════════════════════════════════════╣',\n  `║ tools: ${uniqueTools.join(', ') || 'n/a'}`.padEnd(43, ' ') + '║',\n  `║ action: ${decision.action}`.padEnd(43, ' ') + '║',\n  '║ dashboard: http://127.0.0.1:8787/dashboard ║',\n  '╚══════════════════════════════════════════╝'\n].join('\\n');\n\nconst summary = {\n  project: 'TrainGuard',\n  mode: $('Normalize Input').item.json.mode,\n  called_via_mcp: true,\n  decided_by: decision.decided_by || analyzed.decision?.decided_by || 'unknown',\n  model: decision.model || analyzed.decision?.model || null,\n  mcp_banner: banner,\n  mcp_story: story,\n  mcp_dashboard: 'http://127.0.0.1:8787/dashboard',\n  mcp_integration: 'n8n -> bridge -> MCP Client -> TrainGuard tools (+ Gemini si USE_GEMINI)',\n  mcp_tools_from_analyze: mcpFromAnalyze,\n  mcp_tools_from_status: mcpFromStatus,\n  action: decision.action,\n  confidence: decision.confidence,\n  reason: decision.reason,\n  evidence: decision.evidence,\n  applied: analyzed.applied,\n  run_id: status.run_id || decision.run_id,\n  status: status.status,\n  epoch: status.epoch,\n  lr: status.lr,\n  fault: status.fault,\n  last_action: status.last_action,\n  message: `TrainGuard via ${decision.decided_by || 'MCP'}: ${decision.action} (conf=${decision.confidence}) — ${decision.reason}`\n};\n\nreturn [{ json: summary }];"
      },
      "id": "c9d0e1f2-a3b4-5678-2345-789012345678",
