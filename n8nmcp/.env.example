# Copia este archivo a .env y pega tu key (NUNCA subas .env a git)
GEMINI_API_KEY=tu_api_key_aqui
# Modelos útiles: gemini-3.5-flash-lite | gemini-3.8-flash | gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Si es true, /analyze-and-apply usa Gemini; si falta key, cae a heurística
USE_GEMINI=true
# Si es true, Gemini llama tools MCP (function calling). Si false, solo decide JSON
# y el bridge aplica (modo legacy).
GEMINI_MCP_AGENT=true
# Dashboard → Iniciar: dispara este webhook de n8n (test o production)
N8N_WEBHOOK_URL=https://TU-INSTANCIA.app.n8n.cloud/webhook-test/trainguard
# URL pública del bridge (ngrok) para que n8n Cloud llame de vuelta
BRIDGE_PUBLIC_URL=https://TU-URL.ngrok-free.dev
