# Copia este archivo a .env y pega tu key (NUNCA subas .env a git)
GEMINI_API_KEY=tu_api_key_aqui
# Modelos útiles: gemini-3.5-flash-lite | gemini-3.8-flash | gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Si es true, /analyze-and-apply usa Gemini; si falta key, cae a heurística
USE_GEMINI=true
